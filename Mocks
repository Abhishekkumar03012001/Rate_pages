# PAGE HEADER / FOOTER + PDF BUILDER (unchanged logic)
# =====================================================================
def make_page_drawer(titles, version_text, footer_center, footer_right, mode, page_cnt_title):
    width, height = letter
    page_counter = {"count": 0}

    def draw_page(canvas, doc):
        page_counter["count"] += 1
        canvas.setFont("Helvetica-Bold", 10)
        y = height - 30
        for t in titles:
            if t:
                canvas.drawCentredString(width / 2, y, str(t))
                y -= 13

        canvas.setFont("Helvetica", 8)
        text = format_date(version_text) if version_text else ""

        if mode == "strike":
            canvas.setFillColor(colors.red)
            canvas.drawString(40, 35, text)
            canvas.line(40, 38, 40 + canvas.stringWidth(text, "Helvetica", 8), 38)
            canvas.setFillColor(colors.black)
        elif mode == "highlight":
            canvas.setFillColor(colors.yellow)
            canvas.rect(39, 33, canvas.stringWidth(text, "Helvetica", 8) + 4, 10, fill=1, stroke=0)
            canvas.setFillColor(colors.black)
            canvas.drawString(40, 35, text)
        else:
            canvas.drawString(40, 35, text)

        # reset state explicitly so the footer text is always drawn in black Helvetica 8
        canvas.setFillColor(colors.black)
        canvas.setStrokeColor(colors.black)
        canvas.setFont("Helvetica", 8)
        canvas.drawCentredString(width / 2, 35, footer_center or "")
        canvas.drawRightString(width - 40, 35, footer_right or "")
        canvas.drawRightString(width - 40, 20, f"{page_cnt_title}{page_counter['count']}")

    return draw_page


def build_pdf(df, flags, path, mode, drawer, key_cols, header_style, normal_style):
    """
    mode = "highlight": cells where flags is True get a yellow background
    mode = "strike"   : cells where flags is True are printed red + struck through
    Every column of df is printed. Wide sheets are split over several pages
    (fixed columns repeat on each page). Rows are packed so that a page is
    filled completely and never spills onto an extra page.
    """
    cols = list(df.columns)
    n_rows = len(df)
    pos = {c: i for i, c in enumerate(cols)}

    fixed = [c for c in key_cols if c in pos]
    rest = [c for c in cols if c not in fixed]

    step = max(1, MAX_COLS - len(fixed))
    chunks = [fixed + rest[i:i + step] for i in range(0, len(rest), step)] or [fixed]

    text = {c: [cell_text(v, c in fixed) for v in df[c]] for c in cols}

    page_w, page_h = letter
    m = PAGE_MARGINS
    frame_w = page_w - m["left"] - m["right"]
    frame_h = page_h - m["top"] - m["bottom"]
    usable_h = frame_h - SAFETY
    PAD_H, PAD_V = 4, 2

    def col_widths(n):
        return [70] * n if n < 5 else [frame_w / n] * n

    def make_cell(i, c):
        t = html.escape(text[c][i], quote=False)
        if t and mode == "strike" and flags[i, pos[c]]:
            t = f'<font color="red"><strike>{t}</strike></font>'
        return Paragraph(t or "&nbsp;", normal_style)

    def make_header(c):
        return Paragraph(f"<b>{html.escape(str(c), quote=False)}</b>", header_style)

    def para_h(p, w):
        return p.wrap(w - 2 * PAD_H, 10000)[1]

    chunk_info = []
    for chunk in chunks:
        widths = col_widths(len(chunk))
        hdr_h = max(para_h(make_header(c), w) for c, w in zip(chunk, widths)) + 2 * PAD_V
        row_hs = [
            max(para_h(make_cell(i, c), w) for c, w in zip(chunk, widths)) + 2 * PAD_V
            for i in range(n_rows)
        ]
        chunk_info.append((widths, hdr_h, row_hs))

    def fit_end(row_start):
        """Last row (exclusive) that fits on the page for ALL column chunks."""
        end = n_rows
        for widths, hdr_h, row_hs in chunk_info:
            total, e = hdr_h, row_start
            while e < n_rows and total + row_hs[e] <= usable_h:
                total += row_hs[e]
                e += 1
            end = min(end, e)
        return max(end, row_start + 1)

    def make_table(chunk, widths, r0, r1):
        data = [[make_header(c) for c in chunk]]
        for i in range(r0, r1):
            data.append([make_cell(i, c) for c in chunk])

        t = Table(data, colWidths=widths, hAlign="LEFT")
        style = [
            ("GRID", (0, 0), (-1, -1), 1.2, colors.black),
            ("VALIGN", (0, 0), (-1, -1), "MIDDLE"),
            ("TOPPADDING", (0, 0), (-1, -1), PAD_V),
            ("BOTTOMPADDING", (0, 0), (-1, -1), PAD_V),
            ("LEFTPADDING", (0, 0), (-1, -1), PAD_H),
            ("RIGHTPADDING", (0, 0), (-1, -1), PAD_H),
        ]
        if mode == "highlight":
            for i in range(r0, r1):
                for ci, c in enumerate(chunk):
                    if flags[i, pos[c]]:
                        style.append(("BACKGROUND", (ci, i - r0 + 1), (ci, i - r0 + 1), colors.yellow))
        t.setStyle(TableStyle(style))
        return t

    elements = []
    row_start = 0
    while row_start < n_rows:
        row_end = fit_end(row_start)

        while True:
            tables = [make_table(ch, w, row_start, row_end) for ch, (w, _, _) in zip(chunks, chunk_info)]
            too_tall = any(t.wrap(frame_w, 10000)[1] > usable_h for t in tables)
            if not too_tall or row_end - row_start <= 1:
                break
            row_end -= 1

        for t in tables:
            if elements:
                elements.append(PageBreak())
            elements.append(t)
        row_start = row_end

    doc = BaseDocTemplate(
        path, pagesize=letter,
        leftMargin=m["left"], rightMargin=m["right"],
        topMargin=m["top"], bottomMargin=m["bottom"],
        pageCompression=1,
    )
    frame = Frame(m["left"], m["bottom"], frame_w, frame_h,
                  leftPadding=0, rightPadding=0, topPadding=0, bottomPadding=0, id="main")
    doc.addPageTemplates([PageTemplate(id="main", frames=[frame], onPage=drawer)])
    doc.build(elements)


# =====================================================================
# ONE MEMNAME -> TWO TEMP PDFs (highlight pages + strike pages)
# Runs in a worker process, so it only uses plain, picklable inputs.
# =====================================================================
def _make_styles():
    styles = getSampleStyleSheet()
    normal_style = ParagraphStyle(name="NormalSmall", parent=styles["Normal"],
                                  fontSize=8, leading=9, alignment=1)
    header_style = ParagraphStyle(name="HeaderSmall", parent=styles["Normal"],
                                  fontSize=7, leading=8, alignment=1, textColor=colors.black)
    return normal_style, header_style


def process_one(task):
    """Returns {"ok": bool, "h_path": str, "s_path": str, "reason": str, "log": [str]}"""
    log = []
    try:
        df1, df2 = task["df1"], task["df2"]          # df1 = proposed, df2 = current
        key_cols = task["key_cols"]
        normal_style, header_style = _make_styles()

        highlight_flags = compare_frames(df1, df2, key_cols)   # rows of PROPOSED
        strike_flags = compare_frames(df2, df1, key_cols)      # rows of CURRENT

        footnote_raw = task["footnote_raw"]
        _, center, right = parse_footnote(footnote_raw)

        # footer date (bottom-left) comes ONLY from footnote1
        version = date_from_footnote(footnote_raw)
        if not version:
            log.append("  WARNING: no date found in footnote1 - left footer will be empty")
        log.append(f"  footer left(date) = {version!r} | center = {center!r} | right = {right!r}")

        titles = task["titles"]
        page_cnt_title = task["page_cnt_title"]
        drawer_strike = make_page_drawer(titles, version, center, right, "strike", page_cnt_title)
        drawer_highlight = make_page_drawer(titles, version, center, right, "highlight", page_cnt_title)

        base = task["base_path"]
        pdf_strike, pdf_highlight = base + "_s.pdf", base + "_h.pdf"

        build_pdf(df2, strike_flags, pdf_strike, "strike", drawer_strike,
                  key_cols, header_style, normal_style)
        build_pdf(df1, highlight_flags, pdf_highlight, "highlight", drawer_highlight,
                  key_cols, header_style, normal_style)

        log.append(f"Completed: {task['memname']}")
        return {"ok": True, "h_path": pdf_highlight, "s_path": pdf_strike, "reason": "", "log": log}

    except Exception as e:
        log.append(f"ERROR while processing '{task['memname']}':")
        log.append(traceback.format_exc())
        return {"ok": False, "h_path": "", "s_path": "", "reason": f"Error: {e}", "log": log}


# =====================================================================
# MERGING WITH SIZE LIMIT
# A memname item is (memname, highlight_pdf, strike_pdf).
# A "segment" is (memname, [page refs]); a page ref is (pdf_path, page_index, rank).
# Inside every final PDF all HIGHLIGHT pages come first (first half), then all
# STRIKE pages (second half) - STRIKE_FIRST flips this.
# =====================================================================
def _page_refs(h_path, s_path):
    rank_h, rank_s = (1, 0) if STRIKE_FIRST else (0, 1)
    refs = [(h_path, i, rank_h) for i in range(len(PdfReader(h_path).pages))]
    refs += [(s_path, i, rank_s) for i in range(len(PdfReader(s_path).pages))]
    return sorted(refs, key=lambda r: r[2])


def _build_writer(segments):
    refs = [r for _, rs in segments for r in rs]
    refs.sort(key=lambda r: r[2])            # stable: first-half pages, then second-half pages
    readers = {}
    writer = PdfWriter()
    for path, idx, _ in refs:
        if path not in readers:
            readers[path] = PdfReader(path)
        writer.add_page(readers[path].pages[idx])
    return writer


def _size_of(segments):
    writer = _build_writer(segments)
    buf = io.BytesIO()
    writer.write(buf)
    return buf.tell()


def split_into_parts(items, max_bytes):
    """
    EXACT (slower) splitter, used only as a fallback.
    items: list of (memname, highlight_pdf, strike_pdf) in order.
    Whole memnames are kept together whenever possible; a single memname
    larger than the limit is split by pages.
    """
    parts = []
    current = []

    for memname, h_path, s_path in items:
        refs = _page_refs(h_path, s_path)
        seg = (memname, refs)

        if _size_of(current + [seg]) <= max_bytes:
            current.append(seg)
            continue

        if current:
            parts.append(current)
            current = []

        if _size_of([seg]) <= max_bytes:
            current = [seg]
            continue

        n_pages = len(refs)
        idx = 0
        chunks = []
        while idx < n_pages:
            take = n_pages - idx
            while take > 1 and _size_of([(memname, refs[idx:idx + take])]) > max_bytes:
                take = max(1, int(take * 0.8)) if take > 5 else take - 1
            chunks.append((memname, refs[idx:idx + take]))
            idx += take
        for c in chunks[:-1]:
            parts.append([c])
        current = [chunks[-1]]

    if current:
        parts.append(current)
    return parts


def plan_parts(items, max_bytes):
    """FAST planning: add up the file sizes of the memname PDFs (no re-building)."""
    parts, cur, cur_size = [], [], 0
    for memname, h_path, s_path in items:
        sz = os.path.getsize(h_path) + os.path.getsize(s_path)
        if cur and cur_size + sz > max_bytes:
            parts.append(cur)
            cur, cur_size = [], 0
        cur.append((memname, h_path, s_path))
        cur_size += sz
    if cur:
        parts.append(cur)
    return parts


def merge_group(group_val, items, out_folder, max_bytes):
    """
    Merge all memname PDFs of one group into one or more PDFs (each <= max_bytes).
    Files are written with temporary names; final names are given later.
    Returns list of (temp_pdf_path, [memnames]).
    """
    results = []
    counter = [0]

    def write_part(segs):
        counter[0] += 1
        out_path = os.path.join(out_folder, f"group_{safe_filename(group_val)}_part_{counter[0]}.pdf")
        writer = _build_writer(segs)
        with open(out_path, "wb") as f:
            writer.write(f)
        memnames = []
        for m, _ in segs:
            if m not in memnames:
                memnames.append(m)
        return out_path, memnames

    for part_items in plan_parts(items, max_bytes):
        segs = [(m, _page_refs(h, s_)) for m, h, s_ in part_items]
        out_path, memnames = write_part(segs)

        # the plan is an estimate - verify the real size, fall back to exact splitting if needed
        if os.path.getsize(out_path) > max_bytes:
            os.remove(out_path)
            counter[0] -= 1
            for exact_segs in split_into_parts(part_items, max_bytes):
                results.append(write_part(exact_segs))
        else:
            results.append((out_path, memnames))

    return results


# =====================================================================
# MAPPING EXCEL (highlighted header, red rows for skipped memnames, autofit)
# =====================================================================
MAPPING_COLUMNS = ["Group_Val", "SRT_TAB_ID", "MemName", "PDF Name", "PDF Part", "Remarks"]
NOT_CREATED = "NOT CREATED"


def save_mapping_excel(rows, path):
    df = pd.DataFrame(rows, columns=MAPPING_COLUMNS + ["Missing"])
    missing_flags = df["Missing"].tolist()
    df = df[MAPPING_COLUMNS]

    with pd.ExcelWriter(path, engine="openpyxl") as writer:
        df.to_excel(writer, index=False, sheet_name="Mapping")
        ws = writer.sheets["Mapping"]

        thin = Side(style="thin", color="000000")
        header_fill = PatternFill("solid", start_color="FFD966", end_color="FFD966")

        for cell in ws[1]:
            cell.font = Font(bold=True)
            cell.fill = header_fill
            cell.alignment = Alignment(horizontal="center", vertical="center")
            cell.border = Border(left=thin, right=thin, top=thin, bottom=thin)

        # skipped memnames in red
        red_fill = PatternFill("solid", start_color="F8CBAD", end_color="F8CBAD")
        for excel_row, is_missing in enumerate(missing_flags, start=2):
            if is_missing:
                for cell in ws[excel_row]:
                    cell.fill = red_fill
                    cell.font = Font(bold=True)

        # autofit column widths
        for idx, col_cells in enumerate(ws.columns, start=1):
            longest = max(len(str(c.value)) if c.value is not None else 0 for c in col_cells)
            ws.column_dimensions[get_column_letter(idx)].width = longest + 4

        ws.freeze_panes = "A2"


