# MAIN
# =====================================================================
def run_tasks(tasks):
    """Build all memname PDFs - in parallel when possible, otherwise one by one."""
    if not tasks:
        return []
    if USE_PARALLEL and len(tasks) >= 3:
        workers = max(1, min(MAX_WORKERS, (os.cpu_count() or 2) - 1, len(tasks)))
        if workers > 1:
            try:
                with ProcessPoolExecutor(max_workers=workers) as ex:
                    return list(ex.map(process_one, tasks, chunksize=1))
            except Exception as e:
                print(f"  (parallel build not available: {e}) - building one by one")
    return [process_one(t) for t in tasks]


def mock_generator_main(input_file, config_1, config_2, output_folder, is_merge,
                        pdf_names=PDF_NAMES, max_size_mb=MAX_PDF_SIZE_MB):
    """
    config_1 = PROPOSED repository  -> highlight pages (changed cells in yellow)
    config_2 = CURRENT  repository  -> strike pages    (removed/changed cells in red + strike)

    Only memnames with Table_Include = Yes AND Exclude_Mock = No are printed.
    is_merge = True : memnames with the same Group_Val go into the same PDF(s)
    is_merge = False: every memname is its own group
    """
    base_name = safe_filename(pdf_names)
    max_bytes = int(max_size_mb * 1024 * 1024)

    final_folder = os.path.join(output_folder, OUTPUT_SUBFOLDER)
    os.makedirs(final_folder, exist_ok=True)

    temp_folder = tempfile.mkdtemp(prefix="mock_memname_pdfs_")
    merged_folder = tempfile.mkdtemp(prefix="mock_merged_parts_")

    input_df = pd.read_excel(input_file, sheet_name="Filing_tabs")
    input_df.columns = input_df.columns.str.strip().str.lower()

    if is_merge and "group_val" not in input_df.columns:
        raise ValueError(f"'Group_Val' column not found in Filing_tabs. Columns: {list(input_df.columns)}")

    xl1 = pd.ExcelFile(config_1)
    xl2 = pd.ExcelFile(config_2)
    name1, name2 = os.path.basename(config_1), os.path.basename(config_2)

    jobs = []           # one per memname that can be built: (group_val, srt, memname, task)
    skipped_rows = []   # mapping rows for memnames that were skipped

    def skip(group_val, srt, memname, reason):
        print(f"  SKIPPED: {reason}")
        skipped_rows.append({
            "Group_Val": group_val, "SRT_TAB_ID": srt, "MemName": memname,
            "PDF Name": NOT_CREATED, "PDF Part": "", "Remarks": reason, "Missing": True,
        })

    try:
        # ---------- Step 1: read sheets, decide what to build ----------
        for n, (_, row) in enumerate(input_df.iterrows(), start=1):

            # only print when Table_Include = Yes and Exclude_Mock = No
            check1 = safe_str(row.get("table_include", "")).lower()
            check2 = safe_str(row.get("exclude_mock", "")).lower()
            if not (check1 == "yes" and check2 == "no"):
                continue

            memname = safe_str(row.get("memname", ""))
            if not memname:
                continue
            tab_id = safe_str(row.get("srt_tab_id", ""))

            if is_merge:
                group_val = normalize_group(row.get("group_val", "")) or memname
            else:
                group_val = memname

            print(f"\nProcessing -> {tab_id} : {memname}  (Group_Val = {group_val})")

            sheet1 = find_sheet(xl1, memname)
            sheet2 = find_sheet(xl2, memname)
            not_found = []
            if sheet1 is None:
                not_found.append(f"{name1} (proposed)")
            if sheet2 is None:
                not_found.append(f"{name2} (current)")
            if not_found:
                skip(group_val, tab_id, memname, "Sheet not found in: " + ", ".join(not_found))
                continue

            try:
                df1 = load_sheet(xl1, sheet1)     # proposed
                df2 = load_sheet(xl2, sheet2)     # current

                if df1.empty or df2.empty:
                    skip(group_val, tab_id, memname, "No data rows in one of the config files")
                    continue

                key_cols = get_fixed_columns(df1)
                missing = [c for c in key_cols if c not in df2.columns]
                if missing:
                    skip(group_val, tab_id, memname,
                         f"Key column(s) {missing} missing in {name2} (current)")
                    continue

                task = {
                    "memname": memname,
                    "df1": df1, "df2": df2, "key_cols": key_cols,
                    "titles": [safe_str(row.get(f"title{i}", "")) for i in range(1, 5)],
                    "page_cnt_title": safe_str(row.get("page_cnt_title", "")),
                    "footnote_raw": safe_str(row.get("footnote1", "")),
                    "base_path": os.path.join(temp_folder, f"{n:05d}"),
                }
                jobs.append((group_val, tab_id, memname, task))

            except Exception as e:
                print(f"ERROR while reading '{memname}':")
                traceback.print_exc()
                skip(group_val, tab_id, memname, f"Error: {e}")

        # ---------- Step 2: build all memname PDFs (fast, parallel) ----------
        print(f"\nBuilding {len(jobs)} memname PDF(s) ...")
        results = run_tasks([j[3] for j in jobs])

        groups = {}                 # group_val -> [(memname, highlight_pdf, strike_pdf)], first-appearance order
        memname_srt = {}
        for (group_val, tab_id, memname, _), res in zip(jobs, results):
            print(f"\n[{memname}]")
            for line in res["log"]:
                print(line)
            if res["ok"]:
                memname_srt[memname] = tab_id
                groups.setdefault(group_val, []).append((memname, res["h_path"], res["s_path"]))
            else:
                skip(group_val, tab_id, memname, res["reason"])

        # ---------- Step 3: merge per group (max size enforced) ----------
        all_parts = []  # (group_val, temp_path, memnames) in final order

        for group_val, items in groups.items():
            print(f"\nMerging Group_Val = {group_val} ({len(items)} memname(s))")
            for tmp_path, memnames in merge_group(group_val, items, merged_folder, max_bytes):
                all_parts.append((group_val, tmp_path, memnames))

        # ---------- Step 3b: final names, numbered across ALL groups ----------
        total_files = len(all_parts)
        mapping_rows = []
        all_pdfs = []

        for file_no, (group_val, tmp_path, memnames) in enumerate(all_parts, start=1):
            pdf_name = f"{base_name} page {file_no} of {total_files}.pdf"
            final_path = os.path.join(final_folder, pdf_name)
            shutil.move(tmp_path, final_path)
            all_pdfs.append(final_path)
            print(f"    Saved: {final_path}  ({os.path.getsize(final_path) / 1024 / 1024:.2f} MB)")

            for m in memnames:
                mapping_rows.append({
                    "Group_Val":  group_val,
                    "SRT_TAB_ID": memname_srt.get(m, ""),
                    "MemName":    m,
                    "PDF Name":   pdf_name,
                    "PDF Part":   f"{file_no} of {total_files}",
                    "Remarks":    "",
                    "Missing":    False,
                })

        mapping_rows.extend(skipped_rows)   # skipped memnames at the bottom, in red

        # ---------- Step 4: mapping Excel ----------
        mapping_path = os.path.join(final_folder, MAPPING_EXCEL_NAME)
        save_mapping_excel(mapping_rows, mapping_path)
        print(f"\nMapping sheet saved: {mapping_path}")

    finally:
        shutil.rmtree(temp_folder, ignore_errors=True)
        shutil.rmtree(merged_folder, ignore_errors=True)

    print("\nDONE")
    return all_pdfs


