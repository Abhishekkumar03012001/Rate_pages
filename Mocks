/*====================================================================
  Fire and water PDF report generator  -  SAS Viya version
  Runs the Python report code through PROC PYTHON.

  BEFORE RUNNING
  1. Change the 5 %LET values below (paths are SERVER paths, Linux style,
     not D:\ ; upload input.xlsx and config2.xlsx to the server first).
  2. The Python on the Viya compute server needs these packages:
       pandas, openpyxl, reportlab, pypdf
  3. PROC PYTHON must be configured by your admin (MAS_PYPATH / MAS_M2PATH).

  OUTPUT (same as the Python script): <output_folder>/Proffs/
       "<pdf_names> page N of M.pdf"  files  +  PDF_Mapping.xlsx
====================================================================*/

%let input_file    = /your/server/path/input.xlsx;
%let config_file   = /your/server/path/config2.xlsx;
%let output_folder = /your/server/path/output;
%let pdf_names     = Fire and water;
%let max_size_mb   = 3;

proc python;
submit;
import pandas as pd
import os
import re
import io
import shutil
import tempfile
from pypdf import PdfReader, PdfWriter
from openpyxl.styles import Font, PatternFill, Alignment, Border, Side
from openpyxl.utils import get_column_letter
from reportlab.lib.pagesizes import letter
from reportlab.platypus import SimpleDocTemplate, Table, TableStyle, PageBreak, Paragraph
from reportlab.lib.styles import getSampleStyleSheet, ParagraphStyle
from reportlab.lib import colors

styles = getSampleStyleSheet()
normal_style = ParagraphStyle(name="NormalSmall", parent=styles["Normal"], fontSize=8, leading=9, alignment=1)
header_style = ParagraphStyle(name="HeaderSmall", parent=styles["Normal"], fontSize=8, leading=9, alignment=1)

width, height = letter

# =====================================================================
# USER SETTINGS
# =====================================================================
# Base name for ALL final PDFs. Files are numbered continuously across all
# groups, e.g. "Fire and water page 1 of 6.pdf" ... "Fire and water page 6 of 6.pdf"
PDF_NAMES = SAS.symget("pdf_names")

MAX_PDF_SIZE_MB = float(SAS.symget("max_size_mb"))
OUTPUT_SUBFOLDER = "Proffs"
MAPPING_EXCEL_NAME = "PDF_Mapping.xlsx"


# ===== HELPERS =====
def clean_text(x):
    if pd.isna(x):
        return ""
    return " ".join(str(x).strip().lower().split())


def get_fixed_columns(df):
    for i, col in enumerate(df.columns):
        if str(col).strip().lower() in ["fire", "risk"]:
            return list(df.columns[:i])
    return [df.columns[0]]


def format_value(val):
    try:
        return f"{float(val):.4f}"
    except:
        return str(val)


def transform_display(val):
    try:
        int_val = int(float(val))
        if int_val < -10:
            return "No information"
        if int_val >= 1000:
            return ">1000"
        return str(int_val)
    except:
        return str(val)


def format_date(val):
    try:
        d = pd.to_datetime(val)
        return f"{d.month:02d}/{d.day:02d}/{d.year}"
    except:
        return str(val)


def safe_para(val):
    AMP = chr(38)
    val = str(val).replace(AMP, AMP + "amp;").replace("<", AMP + "lt;").replace(">", AMP + "gt;")
    return Paragraph(val, normal_style)


def header_para(text):
    return Paragraph(f"<b>{text}</b>", header_style)


def parse_footnote(text):
    left   = re.search(r'left\s*"([^"]*)"',   text)
    center = re.search(r'center\s*"([^"]*)"', text)
    right  = re.search(r'right\s*"([^"]*)"',  text)
    return (
        left.group(1).strip()   if left   else "",
        center.group(1).strip() if center else "",
        right.group(1).strip()  if right  else ""
    )


def find_sheet_name_ci(excel_path, target_name):
    """
    Return the actual sheet name inside excel_path that matches target_name
    case-insensitively (and ignoring surrounding whitespace).
    Raises ValueError if no match is found.
    """
    xl = pd.ExcelFile(excel_path)
    target_clean = str(target_name).strip().lower()
    for sheet in xl.sheet_names:
        if str(sheet).strip().lower() == target_clean:
            return sheet
    raise ValueError(
        f"No sheet matching '{target_name}' (case-insensitive) found in {excel_path}. "
        f"Available sheets: {xl.sheet_names}"
    )


def normalize_group(val):
    """Turn Group_Val into a clean text key (1, 1.0, ' 1 ' -> '1')."""
    if pd.isna(val):
        return ""
    s = str(val).strip()
    try:
        f = float(s)
        if f == int(f):
            return str(int(f))
    except:
        pass
    return s


def safe_filename(name):
    name = re.sub(r'[<>:"/\\|?*]', "_", str(name)).strip()
    return name or "unnamed"


# ===== HEADER / FOOTER =====
def make_page_drawer(titles, version_text, footer_center, footer_right, page_cnt_title):

    page_counter = {"count": 0}

    def draw_page(canvas, doc):
        page_counter["count"] += 1

        canvas.setFont("Helvetica-Bold", 10)
        y = height - 30
        for t in titles:
            if t:
                canvas.drawCentredString(width / 2, y, str(t))
                y -= 13

        canvas.setFont("Helvetica", 8)
        text = f"Effective: {format_date(version_text)}"
        canvas.drawString(40, 35, text)

        canvas.drawCentredString(width / 2, 35, footer_center or "")
        canvas.drawRightString(width - 40, 35, footer_right)

        page_text = f"{page_cnt_title} {page_counter['count']}"
        canvas.drawRightString(width - 40, 20, page_text)

    return draw_page


# ===== PDF BUILDER (single memname) =====
def build_pdf(df, path, drawer, fixed_cols):

    doc = SimpleDocTemplate(
        path,
        pagesize=letter,
        leftMargin=40, rightMargin=40,
        topMargin=110,
        bottomMargin=55
    )

    elements = []
    max_cols = 8

    display_cols = list(df.columns)
    fixed_cols   = [c for c in fixed_cols if c in display_cols]
    scrollable_cols = [c for c in display_cols if c not in fixed_cols]

    SAFETY = 15
    usable_height = doc.height - SAFETY

    def get_para(df, row_idx, col):
        val = df.iloc[row_idx][col]
        if isinstance(val, Paragraph):
            return Paragraph(val.text, val.style)
        val = transform_display(val) if col in fixed_cols else format_value(val)
        return safe_para(val)

    def make_table(col_chunk, row_start, row_end):
        col_widths = (
            [70] * len(col_chunk)
            if len(col_chunk) < 5
            else [doc.width / len(col_chunk)] * len(col_chunk)
        )
        data = [[header_para(c) for c in col_chunk]]
        for idx in range(row_start, row_end):
            data.append([get_para(df, idx, col) for col in col_chunk])

        t = Table(data, colWidths=col_widths, splitByRow=1, repeatRows=1)
        t.setStyle(TableStyle([
            ("GRID",          (0, 0), (-1, -1), 1, colors.black),
            ("VALIGN",        (0, 0), (-1, -1), "MIDDLE"),
            ("LEFTPADDING",   (0, 0), (-1, -1), 4),
            ("RIGHTPADDING",  (0, 0), (-1, -1), 4),
            ("TOPPADDING",    (0, 0), (-1, -1), 2),
            ("BOTTOMPADDING", (0, 0), (-1, -1), 2),
        ]))
        return t, col_widths

    def measure_row_end(col_chunk, row_start):
        col_widths = (
            [70] * len(col_chunk)
            if len(col_chunk) < 5
            else [doc.width / len(col_chunk)] * len(col_chunk)
        )
        table_width = sum(col_widths)

        row_end = row_start
        for probe_i in range(row_start, len(df)):
            t, _ = make_table(col_chunk, row_start, probe_i + 1)
            _, h = t.wrap(table_width, usable_height)
            if h > usable_height:
                break
            row_end = probe_i + 1
        return row_end

    row_start = 0
    while row_start < len(df):

        # Build column chunks
        all_chunks = []
        col_start = 0
        while col_start < len(scrollable_cols):
            col_end = min(col_start + (max_cols - len(fixed_cols)), len(scrollable_cols))
            all_chunks.append(fixed_cols + scrollable_cols[col_start:col_end])
            col_start = col_end

        # Find minimum row_end across all chunks
        row_end = len(df)
        for chunk in all_chunks:
            row_end = min(row_end, measure_row_end(chunk, row_start))

        if row_end <= row_start:
            row_end = row_start + 1

        # Render all chunks for this row slice
        for columns in all_chunks:
            col_widths = (
                [70] * len(columns)
                if len(columns) < 5
                else [doc.width / len(columns)] * len(columns)
            )

            data = [[header_para(c) for c in columns]]
            for idx in range(row_start, row_end):
                data.append([get_para(df, idx, col) for col in columns])

            table = Table(data, colWidths=col_widths, hAlign="LEFT", splitByRow=1, repeatRows=1)
            table.setStyle(TableStyle([
                ("GRID",          (0, 0), (-1, -1), 1, colors.black),
                ("VALIGN",        (0, 0), (-1, -1), "MIDDLE"),
                ("LEFTPADDING",   (0, 0), (-1, -1), 4),
                ("RIGHTPADDING",  (0, 0), (-1, -1), 4),
                ("TOPPADDING",    (0, 0), (-1, -1), 2),
                ("BOTTOMPADDING", (0, 0), (-1, -1), 2),
            ]))

            elements.append(table)
            elements.append(PageBreak())

        row_start = row_end

    doc.build(elements, onFirstPage=drawer, onLaterPages=drawer)


# ===== MERGING WITH SIZE LIMIT =====
# A "segment" is (memname, pdf_path, [page indexes]).
def _build_writer(segments):
    writer = PdfWriter()
    for _, path, pages in segments:
        reader = PdfReader(path)
        for p in pages:
            writer.add_page(reader.pages[p])
    return writer


def _size_of(segments):
    writer = _build_writer(segments)
    buf = io.BytesIO()
    writer.write(buf)
    return buf.tell()


def split_into_parts(items, max_bytes):
    """
    items: list of (memname, pdf_path) in order.
    Returns a list of parts; each part is a list of segments that together
    stay within max_bytes. Whole memname PDFs are kept together whenever
    possible; a single memname PDF larger than the limit is split by pages.
    """
    parts = []
    current = []

    for memname, path in items:
        n_pages = len(PdfReader(path).pages)
        seg = (memname, path, list(range(n_pages)))

        # fits into the current part
        if _size_of(current + [seg]) <= max_bytes:
            current.append(seg)
            continue

        # start a new part
        if current:
            parts.append(current)
            current = []

        # fits alone
        if _size_of([seg]) <= max_bytes:
            current = [seg]
            continue

        # too big even alone -> split by pages
        idx = 0
        chunks = []
        while idx < n_pages:
            take = n_pages - idx
            while take > 1 and _size_of([(memname, path, list(range(idx, idx + take)))]) > max_bytes:
                take = max(1, int(take * 0.8)) if take > 5 else take - 1
            chunks.append((memname, path, list(range(idx, idx + take))))
            idx += take
        for c in chunks[:-1]:
            parts.append([c])
        current = [chunks[-1]]

    if current:
        parts.append(current)
    return parts


def merge_group(group_val, items, out_folder, max_bytes):
    """
    Merge all memname PDFs of one group into one or more PDFs (each <= max_bytes).
    Files are written with temporary names; final names are given later.
    Returns list of (temp_pdf_path, [memnames]).
    """
    parts = split_into_parts(items, max_bytes)
    results = []

    for i, segs in enumerate(parts, start=1):
        out_path = os.path.join(out_folder, f"group_{safe_filename(group_val)}_part_{i}.pdf")
        writer = _build_writer(segs)
        with open(out_path, "wb") as f:
            writer.write(f)

        memnames = []
        for m, _, _ in segs:
            if m not in memnames:
                memnames.append(m)
        results.append((out_path, memnames))

    return results


# ===== MAPPING EXCEL (highlighted header + autofit) =====
MAPPING_COLUMNS = ["Group_Val", "SRT_TAB_ID", "MemName", "PDF Name", "PDF Part"]


def save_mapping_excel(rows, path):
    df = pd.DataFrame(rows, columns=MAPPING_COLUMNS)

    with pd.ExcelWriter(path, engine="openpyxl") as writer:
        df.to_excel(writer, index=False, sheet_name="Mapping")
        ws = writer.sheets["Mapping"]

        thin = Side(style="thin", color="000000")
        header_fill = PatternFill("solid", start_color="FFD966", end_color="FFD966")

        for cell in ws[1]:
            cell.font = Font(bold=True)
            cell.fill = header_fill
            cell.alignment = Alignment(horizontal="center", vertical="center")
            cell.border = Border(left=thin, right=thin, top=thin, bottom=thin)

        # autofit column widths
        for idx, col_cells in enumerate(ws.columns, start=1):
            longest = max(len(str(c.value)) if c.value is not None else 0 for c in col_cells)
            ws.column_dimensions[get_column_letter(idx)].width = longest + 4

        ws.freeze_panes = "A2"


# ===== MAIN FUNCTION =====
def generate_single_reports(input_file, config_file, output_folder,
                            pdf_names=PDF_NAMES, max_size_mb=MAX_PDF_SIZE_MB):

    base_name = safe_filename(pdf_names)
    max_bytes = int(max_size_mb * 1024 * 1024)

    final_folder = os.path.join(output_folder, OUTPUT_SUBFOLDER)
    os.makedirs(final_folder, exist_ok=True)

    temp_folder = tempfile.mkdtemp(prefix="memname_pdfs_")
    merged_folder = tempfile.mkdtemp(prefix="merged_parts_")

    input_df = pd.read_excel(input_file, sheet_name="Filing_tabs")
    input_df.columns = input_df.columns.str.strip().str.lower()

    if "group_val" not in input_df.columns:
        raise ValueError(f"'Group_Val' column not found in Filing_tabs. Columns: {list(input_df.columns)}")

    # group_val -> list of (memname, temp_pdf_path), order of first appearance kept
    groups = {}
    memname_srt = {}  # memname -> SRT_TAB_ID from input sheet

    try:
        # ---------- Step 1: build one temp PDF per memname ----------
        for _, row in input_df.iterrows():

            memname = str(row.get("memname", "")).strip()
            if not memname or memname.lower() == "nan":
                continue

            memname_srt[memname] = normalize_group(row.get("srt_tab_id", ""))
            group_val = normalize_group(row.get("group_val", ""))
            if group_val == "":
                group_val = memname  # no group value -> its own group

            print(f" Processing: {memname}  (Group_Val = {group_val})")

            # Case-insensitive sheet name lookup
            sheet_name = find_sheet_name_ci(config_file, memname)

            df = pd.read_excel(config_file, sheet_name=sheet_name).fillna("")
            df = df.map(clean_text) if hasattr(df, "map") else df.applymap(clean_text)

            fixed_cols = get_fixed_columns(df)

            titles         = [str(row.get(f"title{i}", "")) for i in range(1, 5)]
            version        = str(row.get("version_current", ""))
            page_cnt_title = str(row.get("page_cnt_title", ""))
            _, center, right = parse_footnote(str(row.get("footnote1", "")))

            drawer = make_page_drawer(titles, version, center, right, page_cnt_title)

            tmp_pdf = os.path.join(temp_folder, f"{safe_filename(memname)}.pdf")
            build_pdf(df, tmp_pdf, drawer, fixed_cols)

            groups.setdefault(group_val, []).append((memname, tmp_pdf))

        # ---------- Step 2: merge per group (max size enforced) ----------
        all_parts = []  # (group_val, temp_path, memnames) in final order

        for group_val, items in groups.items():
            print(f"\n Merging Group_Val = {group_val} ({len(items)} memname(s))")
            for tmp_path, memnames in merge_group(group_val, items, merged_folder, max_bytes):
                all_parts.append((group_val, tmp_path, memnames))

        # ---------- Step 2b: final names, numbered across ALL groups ----------
        total_files = len(all_parts)
        mapping_rows = []
        all_pdfs = []

        for file_no, (group_val, tmp_path, memnames) in enumerate(all_parts, start=1):
            pdf_name = f"{base_name} page {file_no} of {total_files}.pdf"
            final_path = os.path.join(final_folder, pdf_name)
            shutil.move(tmp_path, final_path)
            all_pdfs.append(final_path)
            print(f"    Saved: {final_path}  ({os.path.getsize(final_path) / 1024 / 1024:.2f} MB)")

            for m in memnames:
                mapping_rows.append({
                    "Group_Val":  group_val,
                    "SRT_TAB_ID": memname_srt.get(m, ""),
                    "MemName":    m,
                    "PDF Name":  pdf_name,
                    "PDF Part":  f"{file_no} of {total_files}",
                })

        # ---------- Step 3: mapping Excel ----------
        mapping_path = os.path.join(final_folder, MAPPING_EXCEL_NAME)
        save_mapping_excel(mapping_rows, mapping_path)
        print(f"\n Mapping sheet saved: {mapping_path}")

    finally:
        shutil.rmtree(temp_folder, ignore_errors=True)
        shutil.rmtree(merged_folder, ignore_errors=True)

    print(" DONE")
    return all_pdfs


generate_single_reports(
    input_file=SAS.symget("input_file"),
    config_file=SAS.symget("config_file"),
    output_folder=SAS.symget("output_folder"),   # "Proffs" folder is created inside this
    pdf_names=PDF_NAMES,
    max_size_mb=MAX_PDF_SIZE_MB,
)

endsubmit;
run;
